#copiar este archivo como .env y completar los valores reales:  cp .env.example .env
#no usar comillas en los valores: docker --env-file las toma literalmente.

#conexión a Postgres para correr con `go run .` en mi pc, (con docker compose esto lo pisa el docker-compose.yml)
DB_URL=postgres://user:password@localhost:port/users?sslmode=disable

#puerto del servidor. lleva ":" adelante.
PORT=:cualquier puerto

#secreto para firmar los JWT. mínimo 32 caracteres. generar uno nuevo para cada entorno con:  openssl rand -hex 32
JWT_SECRET=

#duración de los tokens (formato Go: 1m, 10000h)
ACCESS_TOKEN_DURATION=1m
REFRESH_TOKEN_DURATION=10000h

#carpeta donde se guardan las fotos subidas (opcional, por defecto: uploads)
UPLOAD_DIR=uploads
#true SOLO si la API está detrás de un proxy de confianza que agrega X-Forwarded-For (hosting en producción). en local y en docker compose dejar en false.
TRUST_PROXY=false